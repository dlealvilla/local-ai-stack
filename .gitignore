# Python caches / generated files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Platform-managed runtimes
.runtime/
.venv/
venv/

# Runtime / process state
.state/
logs/
*.log
*.pid

# Platform-local secrets
.webui_secret_key

# Environment / credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Persisted runtime/model artifacts if created inside repo
/models/
.cache/

# NOTE: /checkpoints/ is intentionally NOT ignored. Under the clean-slate
# roadmap it holds versioned stage checkpoints (docs/ROADMAP.md §3), which
# must be committed. Model weights and runtime state belong in /models/
# and .state/ above, which remain ignored.

# Package/build artifacts
build/
dist/
*.egg-info/
# Written into the package by tools/build_prototype.py during a build and
# removed afterwards. Ignored so an interrupted build cannot commit a stale
# build identity, which would make an artifact claim a commit it is not from.
src/kultrun/BUILD.json
src/machi/BUILD.json

# Node/frontend generated dependencies
node_modules/

validation/

# Machi development acceptance lab: live DB, WAL/SHM/journal, raw artifacts.
# Scoped to the lab directory so unrelated SQLite fixtures stay visible to git.
.local/machi-acceptance/
.local/machi-acceptance/**/*.sqlite3
.local/machi-acceptance/**/*.sqlite3-wal
.local/machi-acceptance/**/*.sqlite3-shm
.local/machi-acceptance/**/*.sqlite3-journal

# Development-only Lead Developer ↔ Cursor handoff cache
.machi-handoff/
